# Python
__pycache__/
*.pyc
.pytest_cache/

# Runtime data — created next to the app on first launch; never committed
raw_csvs/
parquet_data/
logs/
settings.json
# Per-user OpenGolfLab contribution state — a random contributor id and the
# local consent record. These are generated per install and must never be
# shared (a committed id would attribute every cloner's uploads to one account).
.contributor_id
.contribute_consent

# Sample-data runtime artifacts (the shipped .parquet files ARE committed;
# anything the app writes into these folders at runtime is not)
sample_data/*.csv.processed
sample_data_progression/*.csv.processed

# Build output
dist/
build/
*.spec
installer/Output/
build_log.txt
full_build_log.txt

# Media renders (attach to a GitHub Release instead of committing)
*.mp4

# Editor / tooling
.claude/
.vscode/
.idea/
